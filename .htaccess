# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/mgvybwur/public_html/edt-api"
PassengerBaseURI "/edt-api"
PassengerNodejs "/home/mgvybwur/nodevenv/public_html/edt-api/22/bin/node"
PassengerAppType node
PassengerStartupFile server.js
PassengerAppLogFile "/home/mgvybwur/edt_back.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# ==============================================================================
# CONFIGURATION BACKEND - EDTS MANAGER
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Autoriser les en-têtes Authorization (JWT)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Ne pas rediriger si le fichier ou dossier existe physiquement (images, uploads)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 3. Support des WebSockets (Socket.io)
    # Si la requête demande un Upgrade vers websocket, on redirige vers ws://
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^(.*)$ ws://127.0.0.1:5000/$1 [P,L]

    # 4. Rediriger tout le reste vers le point d'entrée Node.js (HTTP standard)
    RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]
</IfModule>

# 4. Paramètres de sécurité de base au niveau Apache
<IfModule mod_headers.c>
    # Note: Les en-têtes CORS sont gérés dynamiquement par Express
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# 5. Désactiver le listing des répertoires
Options -Indexes

# 6. Gestion des erreurs personnalisée vers l'API
ErrorDocument 404 /index.php 
# Note : Si vous utilisez Node.js Selector, les erreurs sont normalement gérées par Express
